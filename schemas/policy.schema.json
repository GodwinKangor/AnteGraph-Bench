{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "const": "amount_cents"
                    },
                    "op": {
                      "enum": [
                        ">",
                        ">=",
                        "=="
                      ]
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "field",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "const": "amount_cents"
                    },
                    "op": {
                      "const": "in"
                    },
                    "value": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "field",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "const": "category"
                    },
                    "op": {
                      "enum": [
                        "=="
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "field",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "const": "category"
                    },
                    "op": {
                      "const": "in"
                    },
                    "value": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "field",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "const": "department"
                    },
                    "op": {
                      "enum": [
                        "=="
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "field",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "const": "department"
                    },
                    "op": {
                      "const": "in"
                    },
                    "value": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "field",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "append": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "when",
          "append"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "rules"
  ],
  "additionalProperties": false
}
